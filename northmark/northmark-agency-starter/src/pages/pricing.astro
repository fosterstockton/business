---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const plans = [
  { name: "Starter", build: "$499", monthly: "$79", pages: "Up to 4 pages", updates: "Routine technical maintenance", detail: "A focused starting point for a smaller site." },
  { name: "Business", build: "$799", monthly: "$129", pages: "Up to 7 pages", updates: "60 minutes of content updates / month", detail: "More room for services, information, and growth.", featured: true },
  { name: "Professional", build: "$1,199", monthly: "$199", pages: "Up to 10 pages", updates: "Up to 2 hours of content updates / month", detail: "For businesses with more to explain online." }
];
---

<BaseLayout title="Website design pricing | Northmark" description="Review Northmark's introductory website design and ongoing management prices, included page counts, and content update allowances.">
  <Header />
  <main id="main">
    <section class="bg-paper">
      <div class="content-wrap py-16 sm:py-20 lg:py-24">
        <p class="eyebrow">Straightforward pricing</p>
        <h1 class="font-display mt-4 max-w-4xl text-5xl leading-[1.05] sm:text-6xl">Know what you're choosing before the work begins.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">A one-time build fee launches the agreed website scope. A monthly plan covers defined ongoing management and update time.</p>
        <div class="mt-8 inline-flex flex-wrap gap-x-6 gap-y-2 rounded-xl border border-line bg-white px-5 py-4 text-sm">
          <span><strong>Build</strong> · one time</span><span class="text-slate-400">/</span><span><strong>Management</strong> · monthly</span>
        </div>
      </div>
    </section>

    <section class="content-wrap py-12 sm:py-16">
      <div class="grid gap-4 md:grid-cols-3">
        {plans.map((plan) => (
          <article class={`flex flex-col rounded-2xl border p-6 sm:p-7 ${plan.featured ? "border-ink bg-ink text-white shadow-soft" : "border-line bg-white"}`}>
            {plan.featured && <span class="mb-4 w-fit rounded-full bg-white/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[.13em] text-[#e7b5a2]">More room to grow</span>}
            <h2 class={`text-lg font-bold ${plan.featured ? "text-white" : "text-ink"}`}>{plan.name}</h2>
            <p class={`mt-2 text-sm leading-6 ${plan.featured ? "text-white/65" : "text-slate-500"}`}>{plan.detail}</p>
            <p class={`mt-7 text-xs font-semibold uppercase tracking-wider ${plan.featured ? "text-white/60" : "text-slate-500"}`}>One-time website build</p>
            <p class="font-display mt-1 text-4xl">{plan.build}</p>
            <p class="mt-3"><strong class="text-2xl">{plan.monthly}</strong><span class={`ml-1 text-sm ${plan.featured ? "text-white/65" : "text-slate-500"}`}>/ month</span></p>
            <div class={`my-6 border-t ${plan.featured ? "border-white/20" : "border-line"}`}></div>
            <ul class="grid flex-1 content-start gap-3 text-sm leading-6">
              <li>✓ {plan.pages}</li>
              <li>✓ Mobile-friendly design</li>
              <li>✓ Contact page layout</li>
              <li>✓ {plan.updates}</li>
            </ul>
            <a class={`mt-8 block rounded-full px-5 py-3 text-center text-sm font-bold transition hover:-translate-y-0.5 ${plan.featured ? "bg-white text-ink hover:bg-[#f1eee7]" : "bg-ink text-white hover:bg-[#33423e]"}`} href="/contact">Ask about {plan.name} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <div class="mt-8 grid gap-8 border-t border-line pt-7 md:grid-cols-2">
        <div>
          <h2 class="text-sm font-bold">What's included</h2>
          <p class="mt-2 text-sm leading-7 text-slate-600">The build fee covers the agreed page count, a responsive design, a contact page layout, and launch preparation. Your monthly plan covers the maintenance and content update allowance listed above.</p>
        </div>
        <div>
          <h2 class="text-sm font-bold">What's scoped separately</h2>
          <p class="mt-2 text-sm leading-7 text-slate-600">Domain registration, paid third-party services, copywriting, larger integrations, major redesigns, and work beyond the included update time may cost extra. Unused monthly update time does not roll over.</p>
        </div>
      </div>
      <p class="mt-7 rounded-lg bg-paper px-4 py-3 text-xs leading-6 text-slate-600">These are introductory prices, not a final offer. Confirm availability, deliverables, hosting, support responsibilities, and all fees in a written project scope before purchase.</p>
    </section>

    <section class="bg-paper py-14 sm:py-16">
      <div class="content-wrap flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <p class="eyebrow">Not sure what fits?</p>
          <h2 class="font-display mt-3 text-3xl sm:text-4xl">Start with the site you need today.</h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">The project inquiry form is currently a disabled preview and won't send information until connected.</p>
        </div>
        <a class="button button-dark shrink-0" href="/contact">See the inquiry preview <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
