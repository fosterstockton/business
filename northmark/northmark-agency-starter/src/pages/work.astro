---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Our work | Northmark" description="Explore Northmark's fictional website concept studies for local businesses. These demonstrations are not client projects.">
  <Header />
  <main id="main">
    <section class="bg-paper">
      <div class="content-wrap py-16 sm:py-20 lg:py-24">
        <p class="eyebrow">Concept studies</p>
        <h1 class="font-display mt-4 max-w-4xl text-5xl leading-[1.05] sm:text-6xl">Ideas for businesses with a story to tell.</h1>
        <div class="mt-6 grid max-w-4xl gap-5 md:grid-cols-[1fr_auto] md:items-end">
          <p class="max-w-2xl text-lg leading-8 text-slate-600">These visual studies show the kind of thoughtful, clear websites Northmark can create. Each is a fictional demonstration—not commissioned client work.</p>
          <span class="w-fit rounded-full border border-accent/30 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[.12em] text-accent">All projects shown are concepts</span>
        </div>
      </div>
    </section>

    <section class="content-wrap py-12 sm:py-16">
      <div class="grid gap-8 lg:grid-cols-2">
        <article class="surface-card overflow-hidden">
          <div class="relative overflow-hidden bg-[#e8ebe2] p-4 sm:p-6">
            <div class="rounded-lg border border-[#d1d7ca] bg-[#f7f8f4] shadow-[0_14px_38px_rgba(32,43,42,.12)]">
              <div class="flex items-center justify-between border-b border-[#e1e4dc] px-4 py-3 sm:px-6">
                <span class="font-display text-lg">field &amp; form</span>
                <span class="text-[8px] font-bold uppercase tracking-[.12em] text-slate-500">Garden studio</span>
              </div>
              <div class="grid min-h-64 sm:grid-cols-[.95fr_1.05fr]">
                <div class="flex flex-col items-start justify-center p-5 sm:p-7">
                  <span class="text-[8px] font-bold uppercase tracking-[.16em] text-[#62765f]">Thoughtful outdoor spaces</span>
                  <p class="mt-3 font-display text-3xl leading-[1.05]">Room to<br />grow into.</p>
                  <p class="mt-3 max-w-xs text-[10px] leading-5 text-slate-600">Garden design shaped around the way you live.</p>
                  <span class="mt-4 rounded-full bg-[#455a49] px-4 py-2 text-[8px] font-bold text-white">DISCOVER THE STUDIO ↗</span>
                </div>
                <div class="relative m-3 min-h-48 overflow-hidden rounded-md bg-[linear-gradient(145deg,#83967d,#c2cbb4_50%,#e0d9c2)]">
                  <div class="absolute -bottom-8 left-1/4 h-40 w-40 rounded-full border-[18px] border-white/25"></div>
                  <div class="absolute -right-7 top-8 h-36 w-36 rounded-full bg-[#76866c]/50"></div>
                  <span class="absolute bottom-4 right-4 rounded-full bg-white/85 px-3 py-1 text-[8px] font-bold uppercase tracking-wider text-[#455a49]">Concept only</span>
                </div>
              </div>
            </div>
            <span class="absolute left-6 top-6 rounded-full bg-ink px-3 py-1.5 text-[9px] font-bold uppercase tracking-[.12em] text-white">Fictional concept</span>
          </div>
          <div class="p-6 sm:p-7">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div><p class="eyebrow">Local landscaping · concept study</p><h2 class="mt-2 text-xl font-bold tracking-tight">Field &amp; Form Garden Studio</h2></div>
              <span class="rounded-full bg-paper px-3 py-1.5 text-[10px] font-bold text-slate-600">DEMONSTRATION</span>
            </div>
            <p class="mt-4 text-sm leading-7 text-slate-600">A warm, editorial direction for a fictional garden design studio, with space for project photography, clear services, and a simple inquiry path.</p>
          </div>
        </article>

        <article class="surface-card overflow-hidden">
          <div class="relative overflow-hidden bg-[#e8e7e2] p-4 sm:p-6">
            <div class="rounded-lg border border-[#d5d3cc] bg-[#fcfbf8] shadow-[0_14px_38px_rgba(32,43,42,.12)]">
              <div class="flex items-center justify-between border-b border-[#e8e6df] px-4 py-3 sm:px-6">
                <span class="font-display text-lg">northline</span>
                <span class="text-[8px] font-bold uppercase tracking-[.12em] text-slate-500">Home care</span>
              </div>
              <div class="relative min-h-64 overflow-hidden bg-[#d6ddd9]">
                <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(32,43,42,.72),rgba(32,43,42,.05)),linear-gradient(145deg,#aebdb6,#e2e4dc_55%,#84968c)]"></div>
                <div class="relative flex min-h-64 max-w-sm flex-col items-start justify-center p-6 text-white sm:p-8">
                  <span class="text-[8px] font-bold uppercase tracking-[.16em] text-white/75">Care for the place you call home</span>
                  <p class="mt-3 font-display text-3xl leading-[1.05]">The little<br />things, handled.</p>
                  <p class="mt-3 max-w-[13rem] text-[10px] leading-5 text-white/80">A fictional home services concept built for clarity and calm.</p>
                  <span class="mt-4 rounded-full bg-white px-4 py-2 text-[8px] font-bold text-ink">EXPLORE SERVICES ↗</span>
                </div>
                <span class="absolute bottom-4 right-4 rounded-full bg-white/85 px-3 py-1 text-[8px] font-bold uppercase tracking-wider text-ink">Concept only</span>
              </div>
            </div>
            <span class="absolute left-6 top-6 rounded-full bg-ink px-3 py-1.5 text-[9px] font-bold uppercase tracking-[.12em] text-white">Fictional concept</span>
          </div>
          <div class="p-6 sm:p-7">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div><p class="eyebrow">Home services · concept study</p><h2 class="mt-2 text-xl font-bold tracking-tight">Northline Home Care</h2></div>
              <span class="rounded-full bg-paper px-3 py-1.5 text-[10px] font-bold text-slate-600">DEMONSTRATION</span>
            </div>
            <p class="mt-4 text-sm leading-7 text-slate-600">A confident, mobile-first concept for a fictional local home care business, focused on clear service information and accessible contact actions.</p>
          </div>
        </article>
      </div>

      <div class="mt-12 flex flex-col items-start justify-between gap-5 border-t border-line pt-8 sm:flex-row sm:items-center">
        <p class="max-w-2xl text-sm leading-7 text-slate-600">Names, service descriptions, and visual details shown here are illustrative only. They do not represent actual businesses or client engagements.</p>
        <a class="button button-dark shrink-0" href="/contact">Discuss a website <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
